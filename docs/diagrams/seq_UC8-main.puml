@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Психолог" as ACTOR
boundary ФормаНастроек
control УправлениеНастройками
entity ПараметрыТестирования
ACTOR -> ФормаНастроек : открытьНастройки()
ФормаНастроек -> УправлениеНастройками : получитьПараметры()
УправлениеНастройками -> ПараметрыТестирования : получить()
УправлениеНастройками --> ФормаНастроек : параметры
ACTOR -> ФормаНастроек : изменитьИСохранить(параметры)
ФормаНастроек -> УправлениеНастройками : сохранить(параметры)
УправлениеНастройками -> ПараметрыТестирования : обновить(параметры)
ПараметрыТестирования -> ПараметрыТестирования : проверитьДиапазоны()
УправлениеНастройками --> ФормаНастроек : параметры
ФормаНастроек --> ACTOR : сообщитьОСохранении()
@enduml
