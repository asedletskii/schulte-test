@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Пользователь" as ACTOR
rectangle ФормаРезультатов
rectangle УправлениеРезультатами
rectangle КарточкаИспытуемого
rectangle СеансТестирования
rectangle РезультатТаблицы
rectangle ПоказателиВнимания
ACTOR --> ФормаРезультатов : 1: открытьРезультаты(идентификатор)
ФормаРезультатов --> УправлениеРезультатами : 2: получитьСписок(идентификатор)
УправлениеРезультатами --> КарточкаИспытуемого : 3: проверитьДоступ(идентификатор)
УправлениеРезультатами --> СеансТестирования : 4: найтиЗавершённые(идентификатор)
УправлениеРезультатами --> ФормаРезультатов : 5: списокТестов
ACTOR --> ФормаРезультатов : 6: выбратьТест(идентификаторТеста)
ФормаРезультатов --> УправлениеРезультатами : 7: получитьРезультат(идентификаторТеста)
УправлениеРезультатами --> СеансТестирования : 8: получить(идентификаторТеста)
СеансТестирования --> РезультатТаблицы : 9: получитьВремяИОшибки()
СеансТестирования --> ПоказателиВнимания : 10: получитьПоказатели()
УправлениеРезультатами --> ФормаРезультатов : 11: результат
ФормаРезультатов --> ACTOR : 12: показатьПоказателиИКривуюУтомляемости()
@enduml
