@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Психолог" as ACTOR
rectangle ФормаСравнения
rectangle УправлениеСравнением
rectangle КарточкаИспытуемого
rectangle СеансТестирования
rectangle СравнениеТестов
rectangle ПоказателиВнимания
ACTOR --> ФормаСравнения : 1: открытьСравнение()
ФормаСравнения --> УправлениеСравнением : 2: получитьИспытуемых()
УправлениеСравнением --> КарточкаИспытуемого : 3: найтиВсех()
ACTOR --> ФормаСравнения : 4: выбратьТесты(A, B)
ФормаСравнения --> УправлениеСравнением : 5: сравнить(A, B)
УправлениеСравнением --> СеансТестирования : 6: получить(A, B)
УправлениеСравнением --> СравнениеТестов : 7: создать(тестA, тестB)
СравнениеТестов --> ПоказателиВнимания : 8: получитьПоказатели()
СравнениеТестов --> СравнениеТестов : 9: рассчитатьРазницу()
УправлениеСравнением --> ФормаСравнения : 10: сравнение
ФормаСравнения --> ACTOR : 11: показатьВыводТаблицуДиаграмму()
@enduml
