@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Пользователь" as ACTOR
rectangle ФормаСправки
rectangle РазделСправки
ACTOR --> ФормаСправки : 1: открытьСправку()
ФормаСправки --> РазделСправки : 2: получитьРазделы(роль)
РазделСправки --> ФормаСправки : 3: разделы
ФормаСправки --> ACTOR : 4: показатьПеречень()
ACTOR --> ФормаСправки : 5: выбратьРаздел(заголовок)
ФормаСправки --> РазделСправки : 6: получитьТекст(заголовок)
РазделСправки --> ФормаСправки : 7: текст
ФормаСправки --> ACTOR : 8: показатьТекст()
@enduml
