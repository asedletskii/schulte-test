@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Психолог" as ACTOR
boundary ФормаСравнения
control УправлениеСравнением
entity КарточкаИспытуемого
entity СеансТестирования
entity СравнениеТестов
entity ПоказателиВнимания
ACTOR -> ФормаСравнения : открытьСравнение()
ФормаСравнения -> УправлениеСравнением : получитьИспытуемых()
УправлениеСравнением -> КарточкаИспытуемого : найтиВсех()
ACTOR -> ФормаСравнения : выбратьТесты(A, B)
ФормаСравнения -> УправлениеСравнением : сравнить(A, B)
УправлениеСравнением -> СеансТестирования : получить(A, B)
УправлениеСравнением -> СравнениеТестов : создать(тестA, тестB)
СравнениеТестов -> ПоказателиВнимания : получитьПоказатели()
СравнениеТестов -> СравнениеТестов : рассчитатьРазницу()
УправлениеСравнением --> ФормаСравнения : сравнение
ФормаСравнения --> ACTOR : показатьВыводТаблицуДиаграмму()
@enduml
