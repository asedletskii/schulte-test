@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Пользователь" as ACTOR
boundary ФормаДинамики
control УправлениеДинамикой
entity КарточкаИспытуемого
entity СеансТестирования
entity ДинамикаРезультатов
entity ПоказателиВнимания
ACTOR -> ФормаДинамики : открытьДинамику(идентификатор)
ФормаДинамики -> УправлениеДинамикой : получитьДинамику(идентификатор)
УправлениеДинамикой -> КарточкаИспытуемого : проверитьДоступ(идентификатор)
УправлениеДинамикой -> СеансТестирования : найтиЗавершённые(идентификатор)
УправлениеДинамикой -> ДинамикаРезультатов : построить(тесты)
ДинамикаРезультатов -> ПоказателиВнимания : получитьПоказатели()
ДинамикаРезультатов -> ДинамикаРезультатов : определитьТенденцию()
УправлениеДинамикой --> ФормаДинамики : динамика
ФормаДинамики --> ACTOR : показатьВыводИГрафики()
@enduml
