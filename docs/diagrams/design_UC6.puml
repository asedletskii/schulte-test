@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
class GroupPage <<page>> {

--
+ load(group)
}
class Handler <<adapter>> {

--
+ loginAdmin()
+ loginSubject()
+ startTest()
+ finishTest()
+ getResult()
+ compare()
}
class ResultService <<usecase>> {

--
+ List(p, subjectID)
+ Get(p, id)
+ Delete(p, id)
+ Dynamics(p, subjectID)
+ Compare(p, idA, idB)
+ GroupStats(p, group)
}
interface SubjectRepository {

--
+ Create()
+ Update()
+ Delete()
+ GetByID()
+ List(group)
+ Groups()
}
interface SessionRepository {

--
+ Save()
+ GetByID()
+ ListBySubject()
+ Delete()
}
class GroupStats <<entity>> {
+ Group
+ Members
+ AvgER
+ AvgVR
+ AvgPU
--

}
class Subject <<entity>> {
+ ID
+ FullName
+ BirthYear
+ Group
+ Notes
+ CreatedAt
--
+ Validate(now)
}
class TestSession <<entity>> {
+ ID
+ SubjectID
+ Status
+ Tables
+ Settings
+ StartedAt
+ FinishedAt
+ Results
+ Metrics
--
+ Complete(results, now)
}
GroupPage --> Handler
Handler --> ResultService
ResultService --> SubjectRepository
ResultService --> SessionRepository
ResultService ..> GroupStats
GroupStats "1" o-- "*" Subject
GroupStats ..> TestSession
@enduml
