@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Психолог" as ACTOR
boundary ФормаГруппы
control УправлениеГруппой
entity КарточкаИспытуемого
entity СеансТестирования
entity СводкаПоГруппе
entity ПоказателиВнимания
ACTOR -> ФормаГруппы : выбратьГруппу(название)
ФормаГруппы -> УправлениеГруппой : получитьСводку(название)
УправлениеГруппой -> КарточкаИспытуемого : найтиПоГруппе(название)
loop для каждого участника группы
  УправлениеГруппой -> СеансТестирования : найтиЗавершённые(идентификатор)
end
УправлениеГруппой -> СводкаПоГруппе : построить(участники, тесты)
СводкаПоГруппе -> ПоказателиВнимания : получитьПоказатели()
СводкаПоГруппе -> СводкаПоГруппе : рассчитатьСредниеИРейтинг()
УправлениеГруппой --> ФормаГруппы : сводка
ФормаГруппы --> ACTOR : показатьРейтингИСредние()
@enduml
