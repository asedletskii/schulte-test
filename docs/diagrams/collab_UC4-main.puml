@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Пользователь" as ACTOR
rectangle ФормаДинамики
rectangle УправлениеДинамикой
rectangle КарточкаИспытуемого
rectangle СеансТестирования
rectangle ДинамикаРезультатов
rectangle ПоказателиВнимания
ACTOR --> ФормаДинамики : 1: открытьДинамику(идентификатор)
ФормаДинамики --> УправлениеДинамикой : 2: получитьДинамику(идентификатор)
УправлениеДинамикой --> КарточкаИспытуемого : 3: проверитьДоступ(идентификатор)
УправлениеДинамикой --> СеансТестирования : 4: найтиЗавершённые(идентификатор)
УправлениеДинамикой --> ДинамикаРезультатов : 5: построить(тесты)
ДинамикаРезультатов --> ПоказателиВнимания : 6: получитьПоказатели()
ДинамикаРезультатов --> ДинамикаРезультатов : 7: определитьТенденцию()
УправлениеДинамикой --> ФормаДинамики : 8: динамика
ФормаДинамики --> ACTOR : 9: показатьВыводИГрафики()
@enduml
