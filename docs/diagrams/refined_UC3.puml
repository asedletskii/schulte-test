@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
class ФормаРезультатов <<boundary>> {

--
+ открытьРезультаты(идентификатор)
+ выбратьТест(идентификаторТеста)
}
class УправлениеРезультатами <<control>> {

--
+ получитьСписок(идентификатор)
+ получитьРезультат(идентификаторТеста)
}
class КарточкаИспытуемого <<entity>> {
+ фио
+ годРождения
+ группа
+ примечание
--
+ проверитьДоступ(идентификатор)
}
class СеансТестирования <<entity>> {
+ статус
+ началоТеста
+ конецТеста
--
+ найтиЗавершённые(идентификатор)
+ получить(идентификаторТеста)
}
class РезультатТаблицы <<entity>> {
+ номер
+ время
+ ошибки
--
+ получитьВремяИОшибки()
}
class ПоказателиВнимания <<entity>> {
+ эр
+ вр
+ пу
+ всегоОшибок
--
+ получитьПоказатели()
}
ФормаРезультатов -- УправлениеРезультатами
УправлениеРезультатами -- КарточкаИспытуемого
УправлениеРезультатами -- СеансТестирования
КарточкаИспытуемого "1" -- "0..*" СеансТестирования
СеансТестирования "1" *-- "0..5" РезультатТаблицы
СеансТестирования "1" *-- "0..1" ПоказателиВнимания
@enduml
