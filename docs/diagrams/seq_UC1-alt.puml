@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Психолог" as ACTOR
boundary ФормаВхода
control УправлениеВходом
entity СеансРаботы
ACTOR -> ФормаВхода : ввестиПароль(пароль)
ФормаВхода -> УправлениеВходом : войтиПсихологом(пароль)
УправлениеВходом -> УправлениеВходом : проверитьПароль(пароль)
УправлениеВходом --> ФормаВхода : ошибка(неверныйПароль)
ФормаВхода --> ACTOR : показатьСообщениеОбОшибке()
@enduml
