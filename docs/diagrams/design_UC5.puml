@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
class ComparePage <<page>> {

--
+ compare(a, b)
}
class Handler <<adapter>> {

--
+ loginAdmin()
+ loginSubject()
+ startTest()
+ finishTest()
+ getResult()
+ compare()
}
class ResultService <<usecase>> {

--
+ List(p, subjectID)
+ Get(p, id)
+ Delete(p, id)
+ Dynamics(p, subjectID)
+ Compare(p, idA, idB)
+ GroupStats(p, group)
}
interface SessionRepository {

--
+ Save()
+ GetByID()
+ ListBySubject()
+ Delete()
}
class Comparison <<entity>> {
+ A
+ B
+ DeltaER
+ DeltaVR
+ DeltaPU
+ Better
--

}
class TestSession <<entity>> {
+ ID
+ SubjectID
+ Status
+ Tables
+ Settings
+ StartedAt
+ FinishedAt
+ Results
+ Metrics
--
+ Complete(results, now)
}
class Metrics <<entity>> {
+ WorkEfficiency
+ WarmUp
+ Stability
+ FatigueCurve
+ TotalErrors
--

}
ComparePage --> Handler
Handler --> ResultService
ResultService --> SessionRepository
ResultService ..> Comparison
Comparison "1" --> "2" TestSession
TestSession "1" *-- "0..1" Metrics
@enduml
