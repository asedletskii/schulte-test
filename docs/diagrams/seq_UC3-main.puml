@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Пользователь" as ACTOR
boundary ФормаРезультатов
control УправлениеРезультатами
entity КарточкаИспытуемого
entity СеансТестирования
entity РезультатТаблицы
entity ПоказателиВнимания
ACTOR -> ФормаРезультатов : открытьРезультаты(идентификатор)
ФормаРезультатов -> УправлениеРезультатами : получитьСписок(идентификатор)
УправлениеРезультатами -> КарточкаИспытуемого : проверитьДоступ(идентификатор)
УправлениеРезультатами -> СеансТестирования : найтиЗавершённые(идентификатор)
УправлениеРезультатами --> ФормаРезультатов : списокТестов
ACTOR -> ФормаРезультатов : выбратьТест(идентификаторТеста)
ФормаРезультатов -> УправлениеРезультатами : получитьРезультат(идентификаторТеста)
УправлениеРезультатами -> СеансТестирования : получить(идентификаторТеста)
СеансТестирования -> РезультатТаблицы : получитьВремяИОшибки()
СеансТестирования -> ПоказателиВнимания : получитьПоказатели()
УправлениеРезультатами --> ФормаРезультатов : результат
ФормаРезультатов --> ACTOR : показатьПоказателиИКривуюУтомляемости()
@enduml
