@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Испытуемый" as ACTOR
rectangle ФормаТестирования
rectangle УправлениеТестированием
rectangle ПараметрыТестирования
rectangle СеансТестирования
rectangle ТаблицаШульте
rectangle РезультатТаблицы
rectangle ПоказателиВнимания
ACTOR --> ФормаТестирования : 1: нажатьНачать()
ФормаТестирования --> УправлениеТестированием : 2: начатьТест(идентификатор, параметры)
УправлениеТестированием --> ПараметрыТестирования : 3: получитьПараметры()
УправлениеТестированием --> СеансТестирования : 4: создать(идентификатор, параметры)
СеансТестирования --> ТаблицаШульте : 5: сформироватьКомплект()
УправлениеТестированием --> ФормаТестирования : 6: комплектТаблиц
ACTOR --> ФормаТестирования : 7: выбратьЧисло(n)
ФормаТестирования --> ФормаТестирования : 8: проверитьПорядок(n)
ФормаТестирования --> УправлениеТестированием : 9: завершитьТест(результатыТаблиц)
УправлениеТестированием --> СеансТестирования : 10: завершить(результатыТаблиц)
СеансТестирования --> РезультатТаблицы : 11: создать(номер, время, ошибки)
СеансТестирования --> ПоказателиВнимания : 12: рассчитать(результатыТаблиц)
УправлениеТестированием --> ФормаТестирования : 13: результат
ФормаТестирования --> ACTOR : 14: показатьРезультат()
@enduml
