@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Психолог" as ACTOR
rectangle ФормаИспытуемых
rectangle УправлениеИспытуемыми
rectangle СеансТестирования
rectangle КарточкаИспытуемого
ACTOR --> ФормаИспытуемых : 1: удалить(идентификатор)
ФормаИспытуемых --> УправлениеИспытуемыми : 2: удалить(идентификатор)
УправлениеИспытуемыми --> СеансТестирования : 3: удалитьРезультаты(идентификатор)
УправлениеИспытуемыми --> КарточкаИспытуемого : 4: удалить(идентификатор)
УправлениеИспытуемыми --> ФормаИспытуемых : 5: готово
ФормаИспытуемых --> ACTOR : 6: обновитьСписок()
@enduml
