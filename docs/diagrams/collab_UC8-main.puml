@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
left to right direction
actor "Психолог" as ACTOR
rectangle ФормаНастроек
rectangle УправлениеНастройками
rectangle ПараметрыТестирования
ACTOR --> ФормаНастроек : 1: открытьНастройки()
ФормаНастроек --> УправлениеНастройками : 2: получитьПараметры()
УправлениеНастройками --> ПараметрыТестирования : 3: получить()
УправлениеНастройками --> ФормаНастроек : 4: параметры
ACTOR --> ФормаНастроек : 5: изменитьИСохранить(параметры)
ФормаНастроек --> УправлениеНастройками : 6: сохранить(параметры)
УправлениеНастройками --> ПараметрыТестирования : 7: обновить(параметры)
ПараметрыТестирования --> ПараметрыТестирования : 8: проверитьДиапазоны()
УправлениеНастройками --> ФормаНастроек : 9: параметры
ФормаНастроек --> ACTOR : 10: сообщитьОСохранении()
@enduml
