@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Испытуемый" as ACTOR
boundary ФормаТестирования
control УправлениеТестированием
entity ПараметрыТестирования
entity СеансТестирования
entity ТаблицаШульте
entity РезультатТаблицы
entity ПоказателиВнимания
ACTOR -> ФормаТестирования : нажатьНачать()
ФормаТестирования -> УправлениеТестированием : начатьТест(идентификатор, параметры)
УправлениеТестированием -> ПараметрыТестирования : получитьПараметры()
УправлениеТестированием -> СеансТестирования : создать(идентификатор, параметры)
СеансТестирования -> ТаблицаШульте : сформироватьКомплект()
УправлениеТестированием --> ФормаТестирования : комплектТаблиц
loop для каждой из 5 таблиц
  ACTOR -> ФормаТестирования : выбратьЧисло(n)
  ФормаТестирования -> ФормаТестирования : проверитьПорядок(n)
end
ФормаТестирования -> УправлениеТестированием : завершитьТест(результатыТаблиц)
УправлениеТестированием -> СеансТестирования : завершить(результатыТаблиц)
СеансТестирования -> РезультатТаблицы : создать(номер, время, ошибки)
СеансТестирования -> ПоказателиВнимания : рассчитать(результатыТаблиц)
УправлениеТестированием --> ФормаТестирования : результат
ФормаТестирования --> ACTOR : показатьРезультат()
@enduml
