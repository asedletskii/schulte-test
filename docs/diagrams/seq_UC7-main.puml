@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Serif"
skinparam defaultFontSize 13
skinparam dpi 130
skinparam ArrowFontSize 12
skinparam roundcorner 6
skinparam wrapWidth 320
autonumber
actor "Психолог" as ACTOR
boundary ФормаИспытуемых
control УправлениеИспытуемыми
entity КарточкаИспытуемого
ACTOR -> ФормаИспытуемых : ввестиДанные(фио, годРождения, группа)
ФормаИспытуемых -> УправлениеИспытуемыми : создать(данные)
УправлениеИспытуемыми -> КарточкаИспытуемого : создать(данные)
КарточкаИспытуемого -> КарточкаИспытуемого : проверитьДанные()
КарточкаИспытуемого --> УправлениеИспытуемыми : карточка
УправлениеИспытуемыми --> ФормаИспытуемых : карточка
ФормаИспытуемых --> ACTOR : обновитьСписок()
@enduml
